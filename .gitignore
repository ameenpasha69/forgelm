# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Model caches -- never commit base-model weights. The base model is pinned by
# revision in src/forgelm/modeling.py and downloaded on demand.
.cache/
hf_cache/
*.safetensors.tmp

# Training checkpoints. These are large and fully reproducible; the selected
# adapter is saved separately to artifacts/lora_adapter/.
runs/*/checkpoints/
runs/*/smoke_output/
artifacts/**/checkpoint-*/
*.zip

# The notebook writes its Trainer output to runs/notebook_train/, which the
# pattern above does not match (no /checkpoints/ segment). That gap let ~100 MB
# of throwaway optimiser state into a commit. Match the directory itself, and
# belt-and-braces on the two file types that are always regenerable build
# output rather than evidence.
runs/notebook_train/
**/checkpoint-*/
optimizer.pt
scheduler.pt

# Ablation adapters. The primary adapter (artifacts/lora_adapter/) IS committed
# because it is the deliverable. Tagged ablation adapters are ~35 MB each and
# nobody needs the weights: what carries the finding is their per-example
# predictions in reports/predictions/, which are committed. Regenerate with
#   python scripts/03_train_lora.py --train-fraction 0.5 --tag frac50
artifacts/lora_adapter_*/

# Notebook noise
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Secrets -- nothing in this project needs a token, but belt and braces.
.env
*.pem
*_token*
hf_token*
